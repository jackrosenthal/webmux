{
  "name": "webmux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "build": "NODE_ENV=production bun build --compile --minify --sourcemap=linked --outfile=dist/webmux src/server/index.ts",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.server.json && bun --bun tsc --noEmit -p tsconfig.client.json",
    "fetch-themes": "bun scripts/fetch-gogh-themes.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@tabler/icons-react": "^3.36.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.11.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.8",
    "typescript": "^5.7.0"
  }
}
