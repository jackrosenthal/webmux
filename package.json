{
  "name": "webmux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"bun --watch src/server/index.ts\" \"vite\"",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "pnpm run build:client && pnpm run build:assets",
    "build:client": "vite build",
    "build:assets": "bun scripts/generate-assets.ts",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.server.json && bun --bun tsc --noEmit -p tsconfig.client.json",
    "fetch-themes": "bun scripts/fetch-gogh-themes.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.11.7",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "bun-types": "^1.3.8",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  }
}
